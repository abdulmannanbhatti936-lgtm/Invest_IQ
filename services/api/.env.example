# Database Configuration
POSTGRES_USER=investiq
POSTGRES_PASSWORD=investiq
POSTGRES_DB=investiq
DATABASE_URL=postgresql://investiq:investiq@localhost:5435/investiq
REDIS_URL=redis://localhost:6379/0

# Authentication
JWT_SECRET=placeholder_jwt_secret
JWT_REFRESH_SECRET=placeholder_jwt_refresh_secret

# External APIs
FIREBASE_SERVICE_ACCOUNT_JSON=placeholder_firebase_json
YAHOO_FINANCE_API_KEY=placeholder_yahoo_api_key
PSX_DATA_SOURCE_URL=placeholder_psx_url
NEWS_SCRAPER_SOURCES=placeholder_source1,placeholder_source2

# Chatbot (Phase 8): provider and model are configuration only. Keys stay in .env, never committed.
# LLM_PROVIDER is gemini (default), groq (backup), mistral or claude; LLM_MODEL is its pinned model id.
LLM_PROVIDER=gemini
LLM_MODEL=
# Optional backup: a 429, 5xx or timeout from the primary retries the message here once
LLM_BACKUP_PROVIDER=
LLM_BACKUP_MODEL=
GEMINI_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
CLAUDE_API_KEY=

# Environment
ENVIRONMENT=development
