# Backend base URL (defaults to http://127.0.0.1:8000)
VITE_API_URL=http://127.0.0.1:8000

# Web push (Phase 7), all public values from the Firebase console; leave empty to keep push off.
# Project settings > General > Your apps > Web app > SDK setup and configuration ("Config"):
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Project settings > Cloud Messaging > Web configuration > Web Push certificates > Key pair:
VITE_FIREBASE_VAPID_KEY=
